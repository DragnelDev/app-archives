# --- Servidor ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# --- Seguridad (JWT_SECRET es OBLIGATORIO en producción: openssl rand -hex 48) ---
JWT_SECRET=
JWT_EXPIRES=8h
# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=archivo
DB_PASSWORD=archivo
DB_NAME=archivo_gam
# DATABASE_URL=postgres://user:pass@host:5432/db   (tiene prioridad si se define)
# --- Almacenamiento de PDF (ruta local; fuera del directorio público) ---
STORAGE_DIR=./storage
# --- Primer arranque ---
ADMIN_USERNAME=admin
# Si contiene "#" o espacios, enciérrela entre comillas dobles.
ADMIN_PASSWORD=
# true = carga unidades, usuarios por rol, ICA y cajas de DEMOSTRACIÓN (no usar en producción)
SEED_DEMO=false
